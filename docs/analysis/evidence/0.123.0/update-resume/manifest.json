  "source_observation": {
    "status": "source_static_resume_connected_runtime_unverified",
    "part_reader": "Retains active index, declared length, offset and consecutive failure budget. Interrupted preserves reader/budget; other errors drop response, increment failures, wait up to eight times and reopen same part. Positive reads reset failures and advance offset/progress; early EOF retries. Non206 responses replay the offset without publishing it.",
    "transport_adapter": "NativeParts supplies declared part sizes and offset-aware Range requests, marks206 responses, converts HTTP429/>=500 and transport errors toOther, other status failures toNotFound, logs and sleeps on recoverable failures. Existing gzip/decoded length/hash/staging path consumes resumed body; stage cleanup retains terminal errors.",
    "source_refs": [
      "crates/azeroth-survivors-re/src/update_parts.rs",
      "crates/azeroth-survivors-re/src/update_worker.rs",
      "crates/azeroth-survivors-re/src/update.rs"
    ],
    "limits": "No persistent cross-process resume is introduced; HTTP/filesystem/application execution and parity remain unverified."
  },
  "native_observations": {
    "reader_fields": {
      "0x10": "next part pointer, advances by0x20 before first request",
      "0x18": "end pointer",
      "0x20": "shared compressed-body progress context",
      "0x28/0x30": "active part URL slice",
      "0x38": "declared current part length",
      "0x40": "bytes already returned for current part",
      "0x48/0x50": "optional current Read trait object",
      "0x58": "consecutive nonInterrupted failure count"
    },
    "resume_request": "At nonzero offset, format bytes=<offset>- and set Range. HTTP206 accepts response directly. Other responses pass through bounded prefix discard; short prefix returns UnexpectedEof.",
    "retry": "Interrupted loops without discarding current reader or consuming failure budget. Other errors discard current reader, increment budget, fail after8 or immediately for NotFound. Remaining kinds log and wait min(1<<failures,20) seconds before reopening same part. Request errors map429 and statuses>=500 toOther; other HTTP statuses toNotFound; transport errors toOther.",
    "read": "Positive read resets failure count and adds bytes to current offset and shared progress. Zero before declared part end isUnexpectedEof; completed EOF advances to next part. Prefix replay is discarded before updater progress accounting.",
    "persistence_limit": "State lives in the current reader; no durable cross-process download-resume claim."
  },
