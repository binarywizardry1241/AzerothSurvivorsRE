  "source_contract": {
    "startup": "The 0x1400074e0 guard skips registration without a local state home. 0x140007591 joins Diagnostics and 0x140007627 registers the callback. The PE main thread reserves 0x800000 stack bytes.",
    "filter": "0x14035e6bb checks published configuration and 0x14035e6d1 sets a one-shot latch. Both the first and repeated callbacks reach the previous filter at 0x14035f9a3 if present, else return 0.",
    "files": "One Unix-second value (0 if unavailable) names fault-<seconds>.dmp and fault-<seconds>.txt. The minidump flags are 0x1040. The handle closes before a failed write calls file deletion, and the independent text attempt continues.",
    "exception_labels": {
      "0xc0000005": {
        "comparison": "0x14035f277",
        "text_address": "0x1465c128b",
        "label": "access violation"
      },
