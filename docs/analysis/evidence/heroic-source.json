  "classification": "The selected adjacent owners expose cleanup/deallocation, localization and string-split support. They establish no additional Heroic rank/gameplay policy and do not authorize surrounding engine reconstruction.",
  "source_contracts": {
    "rank_name": "Normal at0; localized Heroic plus one ASCII space plus RomanI..V at1..5; explicit bounds failure at>=6.",
    "selector_from_inputs": "wrapping u64(input_hash+7*u32(discriminator)), preserving the current construction callsite argument operation without assuming input origin.",
    "affix_ids": "rank<3:empty;rank3..4:selector%3;rank>=5:ordered first and(first+((selector/3)&1)+1)%3.",
    "health_damage_descriptors": "Five original48-byte rows hold two twist slices and four f32 scalars: health,damage,marks,reward. Current live guardian,boss-loot and terminalXP consumers bind the four meanings independently. No scalar is inferred from release wording.",
    "parse_rank": "Strict ASCII decimal u8 with optional leading plus, invalid/empty/negative/overflow fallback0, then successful u8 clamp to5. Legacy four-modifier CSV is invalid and becomes0, not a partial rank.",
    "scalar_policies": "Current byte-rank predicates: healing rank>=5:.5 else1; warning rank!=0:.85 else1; revive duration rank>=5:9 else6; revive max-health fraction rank>=5:.3 else.5; per guardian kill HP rank>=2:.35 else.25; damage rank>=2:.07 else.05.",
    "guardian_respawn_seconds": "Current guardian death writes next spawn time=current clock+(rank>=2?150:180). Source exposes only the bounded duration choice.",
    "boss_repeat_factor": "Current rank>=2 supplies ordinary.8/enraged.6; below2 supplies ordinary1/enraged.7. Existing boss state controls the actual enrage flag and timer consumer.",
    "raid_damage_factor": "Current positive aggregate raid-hazard consumer applies rank>=4?3:(endless?1:2) after marker/time messages. The caller must retain this admission/order rather than multiplying every individual effect.",
    "marks_multiplier": "Native leaf145ac0270 returns row+40 for ranks1..5, otherwise Normal0.5. Boss-roll145c135f0 consumes the same field as mark-rate factor.",
    "reward_multiplier": "Native leaf145ac0330 returns row+44 for ranks1..5, otherwise1.0. Boss-loot and terminalXP consume that field; the XPcaller independently caps>5toV before its lookup.",
    "lean_purse": "Current constructor selects initial cacheprice25 at rank>=3 else20, and free reroll base1 at rank>=3 else3 before account perks. Current cachepurchase adds6.25 at rank>=3 else5 after the existing1.3 multiply.",
    "calendar": "current_week returnsu32(SystemTime::now().duration_since(UNIX_EPOCH).seconds/604800), error0. Exact authored zone ordinal mapping withunknown0 feeds the existing wrapping ordinal+7*week selector."
  },
