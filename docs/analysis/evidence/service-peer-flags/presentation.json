  "contracts": {
    "guest": "Live upstream samples host reconnecting and local relay retry independently; caches update before sync/active-local-port delivery gates. Native31/32 use host text; relay retry uses separate local connection text.",
    "host": "Only actual world-assigned source clients produce peer notices. World actors except affected source receive per-recipient localized peer text. Host relay retry notices target local actor0 only.",
    "name": "Source actor context returns a plain clone of current Game+0x1b0 name, without class color or other decoration.",
    "locale": "Recognized exact2-byte locale code overrides global locale for formatting; invalid code leaves global selected locale active. TLS override restored afterward.",
    "delivery": "Actor0 uses first active local port. Remote delivery requires host role3, actual matching world-assigned client row and current+0x479 synchronized byte1; no extra live/abandoned filter in this bounded delivery helper.",
    "packet": "Opcode0x96, system chat10, universal language0, senderGUID0, u32text-byte-length+1, originalUTF8text, NUL, chat-tag0."
  },
  "limits": [
    "Native ranges are PE-declared helper extents, independently decoded; Ghidra pseudocode remains a recovered analysis representation.",
    "EquipmentProbe allocation, memcpy and Vec growth are fixture seams, not reconstructed generic engine internals.",
    "Parent service flag proof owns current frame/pump/getter/cached-transition ranges; these helpers do not duplicate them.",
    "Rust source regressions are uncompiled/unrun. Actual chat delivery/rendering, networking and original/rebuilt parity remain unverified."
  ]
