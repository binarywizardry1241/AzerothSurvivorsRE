      ],
      "semantics": "Clone exact configured String, replacing previous optional URL; no network operation in setter."
    },
    "ensure": {
      "owner": "ensure-service",
      "semantics": "An existing +0x1590 service succeeds immediately. Otherwise require configured URL, create transport and session, retain request/activity times and status connecting. Missing URL returns false and publishes unavailable/co-op needs the game site."
    },
    "vtable": {
      "send": "+0x18",
      "receive": "+0x20",
      "status": "+0x28",
      "close": "+0x30"
    },
    "status": {
      "owner": "connection-status",
      "values": {
        "0": "connecting",
        "1": "connected",
        "2": "dead"
      },
      "semantics": "Worker writes 1 after socket setup; thread-exit-status writes 2 after every worker return. close-signal atomically sets separate cancellation byte1."
    },
    "wire": {
      "owner": "websocket-worker",
      "send_sites": [
        "0x14586ad49",
        "0x14586ad8a"
      ],
      "semantics": "Dequeue an already encoded native Vec; vec-to-bytes changes allocation ownership only. Send exactly those bytes as one WebSocket Binary. Received Binary payloads are cloned into the incoming queue; text and control frames are not native payloads. The native send owner enqueues a frame then flushes; worker does not requeue a send that returns Io(WouldBlock).",
      "send_owner": "websocket-send",
      "send_owner_sites": [
        "0x14582a3e6",
        "0x14582a472",
        "0x14582a6c8"
      ]
    },
    "activity": {
      "owner": "websocket-worker",
      "reset_sites": [
        "0x14586ad29",
        "0x14586af20"
      ],
      "semantics": "Reset Instant before each dequeued outbound send attempt, including WouldBlock, and on each incoming Binary, including empty. Other received variants do not reset it."
    },
    "socket_mode": {
      "owner": "websocket-worker",
      "initial_sites": [
        "0x14586aa5e",
        "0x14586aaa4",
        "0x14586ab10",
        "0x14586ab56"
      ],
      "mode_sites": [
        "0x14586abc6",
        "0x14586ac0c",
        "0x14586ac5b"
      ],
      "semantics": "Set TCP_NODELAY true, initially nonblocking true and read timeout 40000000ns. At each iteration, nonblocking is elapsed whole seconds ==0; only a mode change repeats nonblocking/read-timeout setters. Their errors are dropped."
    },
    "send_errors": {
      "owner": "websocket-worker",
      "sites": [
        "0x14586ad90",
        "0x14586add3",
        "0x14586ae32"
      ],
      "semantics": "Only WebSocket Io WouldBlock(ErrorKind0x0d) is admitted; other errors terminate worker. No Interrupted retry and no TimedOut admission on send."
    },
    "read_errors": {
      "owner": "websocket-worker",
      "sites": [
        "0x14586afb1",
        "0x14586afdb",
        "0x14586b02c",
        "0x14586b039",
        "0x14586b063",
        "0x14586b165",
        "0x14586b19c",
        "0x14586b27a"
      ],
      "semantics": "Only WebSocket Io WouldBlock(0x0d) or TimedOut(0x16) continues. Only this idle-read arm attempts pending-output flush, fails on any flush error, then sleeps1000000ns if current mode is nonblocking. Binary, text and control receives iterate immediately. Interrupted(0x23) is not admitted."
    },
    "close": {
      "owner": "websocket-worker",
      "sites": [
        "0x14586aca0",
        "0x14586b37c",
        "0x14586b39e",
        "0x14586b3da",
        "0x14586b42b"
      ],
      "semantics": "Cancellation is checked before draining outgoing queue. Issue close(None), attempt flush and release socket; worker itself contains one connect attempt and no reconnect loop."
    },
