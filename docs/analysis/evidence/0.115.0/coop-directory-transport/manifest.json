      "caller_site": "0x14586a9fa",
      "maximum_redirects": 3,
      "semantics": "The caller supplies default configuration and redirect maximum3 to the selected tungstenite0.30 connect implementation. No worker-level reconnect loop is introduced; URI/DNS/TCP/TLS/HTTP work remains owned by the pinned library."
    }
