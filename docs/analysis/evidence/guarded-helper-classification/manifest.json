      },
      {
        "path": "crates/azeroth-survivors-re/src/coop/tcp.rs",
        "sha256": "791750b577dd42c6a81cc6caeb243a0893aeb1fd65480f6ec9899d07a89b8a90"
      }
    ],
    "conclusion": "Existing DirectoryResponse/WireLobby use owned String/Vec fields; Rust supplies their lifetime cleanup. Existing tungstenite/std::io adapters already own socket error handling. The bounded native classification proves no source discrepancy and does not revalidate the entire parser or transport.",
    "observations": [
      {
        "path": "crates/azeroth-survivors-re/src/coop/directory_wire.rs",
        "fragments": [
          "pub enum DirectoryResponse",
          "Lobbies(Vec<WireLobby>)",
          "strings: [String; 3]",
          "bytes: Vec<u8>"
        ]
      },
      {
        "path": "crates/azeroth-survivors-re/src/coop/websocket.rs",
        "fragments": [
          "use tungstenite::{Error, Message, WebSocket",
          "Err(Error::Io(error)) if error.kind() == ErrorKind::WouldBlock",
          "ErrorKind::WouldBlock | ErrorKind::TimedOut",
          "self.socket.flush().map_err"
        ]
      },
      {
        "path": "crates/azeroth-survivors-re/src/coop/tcp.rs",
        "fragments": [
          "use std::io::{self, ErrorKind, Read, Write};",
          "Err(error) if error.kind() == ErrorKind::Interrupted => continue"
        ]
      }
    ]
  },
