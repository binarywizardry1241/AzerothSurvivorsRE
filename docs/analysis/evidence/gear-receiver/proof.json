  "source_connections": {
    "path": "crates/azeroth-survivors-re/src/gameplay/coop.rs",
    "fragments": [
      "fn receive_equipment_grants(",
      "GearSave::read(&menu.backend_save).owned",
      "RunEvent::EquipmentLoot",
      "game.events.extend(events);",
      "self.pending_events.extend(events);",
      "state.receive_equipment_grants(&mut run, &mut menu, &ids);",
      "game.events.extend(std::mem::take(&mut state.pending_events));",
      "self.pending_events.clear();"
    ],
    "fragment_sha256": "8ff9277f0526dbadca88e52585e990f22ea65152c8bf2ea0e2769f31f0a81a00",
    "tester_save_gate_present": true,
    "tester_contract": {
      "fragments": [
        "let retain = self.entry.and_then(|entry| entry.roster_guid).is_some_and(|guid| guid != crate::startup::TESTER_GUID);",
        "let mut owned = crate::armory::GearSave::read(&menu.backend_save).owned;",
        "let mut dirty = false;",
        "let events = ids.iter().map(|&id| {\n                let is_new = !owned.contains(&id);\n                if is_new && retain { owned.insert(id); dirty = true; }\n                RunEvent::EquipmentLoot { id, is_new }\n            }).collect::<Vec<_>>();",
        "if dirty { menu.backend_save.add_equipment(ids); menu.commit_account(); }"
      ],
      "fragment_sha256": "a65d3e3450f8d6805ead793ab70cfd0bdb913af6e08496c83b00f920672d5da4",
      "tester_guid": "0xffffff",
