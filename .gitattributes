# Empty TSV columns and literal VM output spaces are part of the upstream fixtures.
/reference/*.tsv whitespace=-blank-at-eol
/crates/benilla-ui/tests/*.golden whitespace=-blank-at-eol
# Canonical decompiler exports preserve the exact normalized provider result.
/docs/analysis/evidence/**/*.c whitespace=-blank-at-eol,-blank-at-eof
/docs/analysis/evidence/**/*.asm whitespace=-blank-at-eol,-blank-at-eof
/docs/analysis/evidence/*/sanguine-native.txt whitespace=-blank-at-eol,-blank-at-eof

# Keep the vendored GPU backend source byte for byte.
third_party/wgpu-hal/** -text
third_party/wgpu-hal/src/auxil/dxgi/result.rs whitespace=cr-at-eol
third_party/wgpu-hal/README.md whitespace=-blank-at-eof

# strtod input fixtures can start with a space before the field delimiter.
crates/benilla-lua/tests/strtod.tsv whitespace=-space-before-tab
